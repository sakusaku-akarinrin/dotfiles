# ╭──────────────────────────────────────────────╮
# │   🌸  Sakura Season · Mako Notifications  🌸  │
# │   Soft cherry-blossom warmth                 │
# ╰──────────────────────────────────────────────╯
# Palette:
#   Cherry blossom ... #f0a0b0    Normal border
#   Pale rose ........ #d4a8b8    Low-urgency border
#   Akane red ........ #d44a5a    Critical border
#   Rosewood bg ...... #161218    Toast background
#   Warm white ....... #f0e4e8    Primary text
#   Soft sage ........ #a0d4a8    Progress bar

# ── General ─────────────────────────────────

sort=-time
layer=overlay
anchor=top-right
max-visible=5
default-timeout=5000
width=360
margin=12,12,12,12
padding=16
border-size=2
border-radius=10
font=Ubuntu Nerd Font 11
markup=1
actions=1
icons=1
max-icon-size=48
ignore-timeout=0

# ── Global style (base) ─────────────────────

background-color=#161218cc
text-color=#f0e4e8
border-color=#f0a0b0
progress-color=over #a0d4a8

# ── Urgency levels ──────────────────────────

[urgency=low]
background-color=#161218cc
border-color=#d4a8b8
text-color=#d0c0c8
default-timeout=4000

[urgency=normal]
background-color=#161218cc
border-color=#f0a0b0
text-color=#f0e4e8

[urgency=critical]
background-color=#2a222ccc
border-color=#d44a5a
text-color=#f0e4e8
default-timeout=0
border-size=3

# ── Per-application accents ─────────────────

# Discord — soft blurple accent
[app-name="Discord"]
border-color=#9098c0

# Spotify — muted green
[app-name="Spotify"]
border-color=#a0d4a8

# Terminal (Alacritty) — match the shell accent
[app-name="Alacritty"]
border-color=#d4a8b8

# Firefox — warm amber
[app-name="Firefox"]
border-color=#e8a870

# System / dunstify test — cherry blossom
[app-name="notify-send"]
border-color=#f0a0b0

# ── Format ──────────────────────────────────

format=<b>%s</b>\n<span size="small" alpha="70%">%b</span>
