// ╭────────────────────────────────────────────╮
// │   🌸  Akane Sakurai · Niri Config  🌸    │
// │   Gentle. Professional. Organized.        │
// ╰────────────────────────────────────────────╯
//
//  Palette — "Sakura Season" (桜の季節)
//  ─────────────────────────────────────────
//  Active accent .... #f0a0b0  (cherry blossom pink)
//  Inactive ......... #7b7b9e  (soft lavender grey)
//  Border ........... #d4a8b8  (pale rose)
//  Urgent ........... #d44a5a  (madder red — 茜 akane)
//  Shadow ........... #00000020 (whisper)
//
//  Philosophy: A tidy desk is a tidy mind.
//  Everything in its place. Soft edges, warm tones.
//  Let the workspace breathe.

// ─── Input ───────────────────────────────────

input {
    keyboard {
        xkb {
            // Extend this with your own layout:
            layout "us,th"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        // natural-scroll
    }

    // Warp to newly focused windows — efficient, like a good secretary.
    warp-mouse-to-focus

    // Follow focus gently when the mouse drifts.
    focus-follows-mouse max-scroll-amount="0%"
}

// ─── Outputs ─────────────────────────────────
// External monitor above the laptop screen.

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "eDP-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=0 y=1080
}

// ─── Layout — "A Place for Everything" ────

layout {
    // Comfortable breathing room between windows.
    gaps 12

    // Center the focused column so it's always in view.
    center-focused-column "always"

    // Three preset widths for quick toggling (Mod+R).
    preset-column-widths {
        proportion 0.33333   // one-third  — quick glance
        proportion 0.5       // half       — side-by-side (default)
        proportion 0.66667   // two-thirds — deep focus
    }

    // New windows open at half-width by default — balanced.
    default-column-width { proportion 0.5; }

    // ── Focus Ring ──────────────────────
    focus-ring {
        width 3
        // Sakura pink — warm and inviting.
        active-color   "#f0a0b0"
        // Soft lavender grey — present but not demanding.
        inactive-color "#7b7b9e"

        // Active gradient: cherry blossom dawn.
        active-gradient from="#f8c0d0" to="#e898a8" angle=135 relative-to="workspace-view"
        // Inactive gradient: muted dusk.
        inactive-gradient from="#7b7b9e" to="#5b5b7e" angle=135 relative-to="workspace-view"
    }

    // ── Border ──────────────────────────
    border {
        // Subtle border always visible — frames the workspace neatly.
        width 2
        active-color   "#d4a8b8"
        inactive-color "#5b5b7e"
        // Akane red for urgent attention.
        urgent-color   "#d44a5a"

        active-gradient from="#e8b8c8" to="#c898a8" angle=135 relative-to="workspace-view"
        inactive-gradient from="#5b5b7e" to="#4b4b6e" angle=135 relative-to="workspace-view"
    }

    // ── Shadow — Soft Depth ─────────────
    shadow {
        on
        softness 24
        spread   4
        offset x=0 y=4
        color "#00000020"
        draw-behind-window true
    }

    // ── Struts — leave room for bars ────
    struts {
        // left 64
        // right 64
        // top 32
        // bottom 0
    }
}

// ─── Startup ─────────────────────────────────

// Ashell — Wayland status bar
spawn-at-startup "ashell"

// Formerly waybar — replaced by ashell
// spawn-at-startup "waybar"

// Wallpaper — animated (swww)
spawn-at-startup "swww-daemon"
spawn-sh-at-startup "sleep 0.5 && swww img ~/.config/wallpaper/wallpaper.jpg"

// Optional: notification daemon
// spawn-at-startup "mako"

// Clipboard manager
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"

// ─── Hotkey Overlay ──────────────────────────

hotkey-overlay {
    // Show the overlay on first launch — good for learning.
    skip-at-startup
}

// ─── Preferences ─────────────────────────────

// Ask clients to omit their own decorations.
// Niri will draw clean, uniform borders instead.
prefer-no-csd

// Screenshots go to a tidy, timestamped location.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ─── Alt+Tab Switcher — Sakura Pink ─────────

recent-windows {
    debounce-ms 750
    open-delay-ms 150

    highlight {
        active-color  "#f0a0b0ff"   // cherry blossom pink
        urgent-color  "#d44a5aff"   // madder red — 茜 akane
        padding 24
        corner-radius 14
    }

    previews {
        max-height 480
        max-scale 0.5
    }

    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }

        Mod+Tab         { next-window; }
        Mod+Shift+Tab   { previous-window; }
        Mod+grave       { next-window     filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

// ─── Blur — Acrylic Background (26.04+) ───

blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.5
}

// ─── Animations — Smooth & Gentle ───────────

animations {
    // Slightly slower for a calm, deliberate feel.
    // slowdown 1.5
}

// ─── Window Rules — Keep Things Tidy ─────────

// WezTerm: fix the initial configure quirk.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Alacritty: acrylic blur effect
window-rule {
    match app-id="^Alacritty$"

    // Draw border around the window, not as a solid rectangle behind it.
    // Without this, the focus ring/border solid rectangle shows through the
    // transparent background and the blur acts on the border color, not the wallpaper.
    draw-border-with-background false

    background-effect {
        blur true
    }
}

// Firefox PiP: float by default (don't steal a whole column).
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Rounded corners for a softer look.
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Block password managers from screen capture.
// Uncomment when you use one:
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

// ─── Keybinds — Efficient & Intuitive ────────

binds {
    // ── Overlay ─────────────────────────
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ── Launchers ───────────────────────
    Mod+Return hotkey-overlay-title="Terminal (Alacritty)"  { spawn "alacritty"; }
    Mod+D      hotkey-overlay-title="App Launcher (fuzzel)" { spawn "fuzzel"; }
    Mod+Shift+Period hotkey-overlay-title="😊 Emoji Picker" { spawn-sh "~/.config/scripts/fuzzel-emoji"; }
    Mod+Shift+C      hotkey-overlay-title="📋 Clipboard History" { spawn-sh "cliphist list | fuzzel -d | cliphist decode | wl-copy"; }

    // Lock screen — pick one:
    Super+Alt+L hotkey-overlay-title="Lock (gtklock)"   { spawn "gtklock"; }
    // Super+Alt+L hotkey-overlay-title="Lock (swaylock)" { spawn "swaylock"; }

    // Screen reader toggle.
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null {
        spawn-sh "pkill orca || exec orca";
    }

    // ── Audio (ashell OSD) ─────────────
    XF86AudioRaiseVolume allow-when-locked=true { spawn "ashell" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "ashell" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "ashell" "msg" "volume-toggle-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "ashell" "msg" "microphone-toggle-mute"; }

    // ── Media (MPRIS) ───────────────────
    XF86AudioPlay  allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop  allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev  allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext  allow-when-locked=true { spawn-sh "playerctl next"; }

    // ── Brightness (ashell OSD) ─────────
    XF86MonBrightnessUp   allow-when-locked=true { spawn "ashell" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "ashell" "msg" "brightness-down"; }

    // ── Overview ────────────────────────
    Mod+O repeat=false { toggle-overview; }

    // ── Close ───────────────────────────
    Mod+Q repeat=false { close-window; }

    // ── Navigation ──────────────────────
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home     { focus-column-first; }
    Mod+End      { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // ── Monitor Switching ───────────────
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // ── Workspaces ──────────────────────
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // ── Scroll ──────────────────────────
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // ── Column Management ──────────────
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    // ── Sizing ─────────────────────────
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M       { maximize-window-to-edges; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    Mod+C       { center-column; }
    Mod+Ctrl+C  { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ── Floating ────────────────────────
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // ── Tabbed Columns ──────────────────
    Mod+W { toggle-column-tabbed-display; }

    // ── Screenshots ─────────────────────
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // ── Escape Hatch ────────────────────
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ── Session ─────────────────────────
    Mod+Shift+E hotkey-overlay-title="⏻ Power Menu (wlogout)" { spawn "wlogout"; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P     { power-off-monitors; }

    // ── Layout Switching ───────────────
    Alt+Shift+1 hotkey-overlay-title="🇺🇸 English" { spawn-sh "~/.config/niri/switch-to-layout.sh 0"; }
    Alt+Shift+2 hotkey-overlay-title="🇹🇭 ภาษาไทย" { spawn-sh "~/.config/niri/switch-to-layout.sh 1"; }
}
