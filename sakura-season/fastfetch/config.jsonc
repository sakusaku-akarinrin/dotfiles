{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "none" },
    "display": {
        "separator": "  ",
        "key": {
            "type": "both",
            "paddingLeft": 2
        }
    },
    "modules": [
        { "type": "custom", "format": "{##f0a0b0}🌸  System{#}" },
        "separator",
        {
            "type": "os",
            "key": "  OS       ",
            "keyColor": "#f0a0b0"
        },
        {
            "type": "kernel",
            "key": "  Kernel   ",
            "keyColor": "#d4a8b8"
        },
        {
            "type": "wm",
            "key": "  WM       ",
            "keyColor": "#9098c0"
        },
        {
            "type": "terminal",
            "key": "  Terminal ",
            "keyColor": "#d4a8b8"
        },
        {
            "type": "shell",
            "key": "  Shell    ",
            "keyColor": "#9098c0"
        },
        {
            "type": "uptime",
            "key": "  Uptime   ",
            "keyColor": "#f0a0b0"
        },
        "break",
        { "type": "custom", "format": "{##a0d4a8}⚙  Hardware{#}" },
        "separator",
        {
            "type": "cpu",
            "key": "  CPU      ",
            "keyColor": "#d4a8b8",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "  GPU      ",
            "keyColor": "#9098c0"
        },
        {
            "type": "memory",
            "key": "  Memory   ",
            "keyColor": "#e8a870",
            "percent": { "type": 3 }
        },
        {
            "type": "disk",
            "key": "  Disk     ",
            "keyColor": "#a0d4a8",
            "folders": "/",
            "percent": { "type": 3 }
        },
        {
            "type": "battery",
            "key": "  Battery  ",
            "keyColor": "#d4a8b8",
            "percent": { "type": 3 }
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
