{
    "layer": "top",
    "position": "top",
    "height": 28,

    // ── Module Layout ──────────────────────
    "modules-left":  ["niri/workspaces"],
    "modules-center": ["niri/window"],
    "modules-right": ["custom/language", "pulseaudio", "network", "cpu", "memory", "battery", "custom/sakura", "tray", "clock"],

    // ── Niri Workspaces ────────────────────
    "niri/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "urgent":    "",
            "focused":   "🌸",
            "default":   "·"
        }
    },

    // ── Niri Window Title ──────────────────
    "niri/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": " $1",
            "(.*) - Visual Studio Code": " $1"
        }
    },

    // ── Custom: Keyboard Language ──────────
    "custom/language": {
        "format": "⌨️ {}",
        "exec": "~/.config/waybar/lang.sh",
        "interval": "once",
        "signal": 1,
        "tooltip": false
    },

    // ── Custom: Sakura Separator ──────────
    "custom/sakura": {
        "format": "🌸",
        "interval": "once",
        "exec": "echo",
        "tooltip": false
    },

    // ── Tray ───────────────────────────────
    "tray": {
        "spacing": 8,
        "icon-size": 18
    },

    // ── Clock ──────────────────────────────
    "clock": {
        "format": "🕐 {:%a %d %b  %H:%M}",
        "format-alt": "🕐 {:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // ── CPU ────────────────────────────────
    "cpu": {
        "format": "🖥️ {usage}%",
        "interval": 2,
        "tooltip": true
    },

    // ── Memory ─────────────────────────────
    "memory": {
        "format": "💾 {}%",
        "interval": 5,
        "tooltip": true
    },

    // ── Battery ────────────────────────────
    "battery": {
        "bat": "BAT0",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "🔋 {capacity}% {icon}",
        "format-icons": ["", "", "", "", ""],
        "format-charging": "⚡ {capacity}% ",
        "tooltip": true
    },

    // ── Network ─────────────────────────────
    "network": {
        "format-wifi": "📶 {essid}  {signalStrength}%",
        "format-ethernet": "🌐 {ipaddr}",
        "format-disconnected": " ⚠️ Offline",
        "tooltip-format": "{ifname} — {ipaddr}/{cidr}",
        "on-click": "nm-connection-editor"
    },

    // ── PulseAudio ─────────────────────────
    "pulseaudio": {
        "format": "🔊 {volume}% {icon}",
        "format-bluetooth": "🔊 {volume}% {icon}",
        "format-muted": "🔇 Muted",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "tooltip": true
    },

    // ── Spotify (optional) ─────────────────
    "custom/spotify": {
        "format": " {}",
        "max-length": 40,
        "interval": 30,
        "exec": "$HOME/.config/waybar/mediaplayer.sh 2>/dev/null",
        "exec-if": "pgrep spotify"
    }
}
