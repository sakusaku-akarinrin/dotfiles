{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "none" },
    "display": {
        "separator": "  ",
        "constants": [
            "─────────────────────────────"
        ],
        "key": {
            "type": "both",
            "paddingLeft": 2
        }
    },
    "modules": [
        // ═══════════════════════════════
        //  ✉️  System
        // ═══════════════════════════════
        { "type": "custom", "format": "┌{$1} {#8888cc}✉️  System{#} {$1}┐" },
        "break",
        {
            "type": "os",
            "key": "  OS       ",
            "keyColor": "#8888cc"
        },
        {
            "type": "kernel",
            "key": "  Kernel   ",
            "keyColor": "#d4b06a"
        },
        {
            "type": "wm",
            "key": "  WM       ",
            "keyColor": "#5a6088"
        },
        {
            "type": "terminal",
            "key": "  Terminal ",
            "keyColor": "#d4b06a"
        },
        {
            "type": "shell",
            "key": "  Shell    ",
            "keyColor": "#5a6088"
        },
        {
            "type": "uptime",
            "key": "  Uptime   ",
            "keyColor": "#8888cc"
        },
        { "type": "custom", "format": "└{$1}────────────────────{$1}┘" },
        "break",

        // ═══════════════════════════════
        //  ⚙  Hardware
        // ═══════════════════════════════
        { "type": "custom", "format": "┌{$1} {#5a9e7a}⚙  Hardware{#} {$1}┐" },
        "break",
        {
            "type": "cpu",
            "key": "  CPU      ",
            "keyColor": "#d4b06a",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "  GPU      ",
            "keyColor": "#5a6088"
        },
        {
            "type": "memory",
            "key": "  Memory   ",
            "keyColor": "#d4b06a",
            "format": "{used} / {total}  [{bar}]"
        },
        {
            "type": "disk",
            "key": "  Disk     ",
            "keyColor": "#5a9e7a",
            "folders": "/",
            "format": "{used} / {size}  [{bar}]"
        },
        {
            "type": "battery",
            "key": "  Battery  ",
            "keyColor": "#d4b06a",
            "format": "{capacity}%  [{bar}]"
        },
        { "type": "custom", "format": "└{$1}────────────────────{$1}┘" },
        "break",

        // Color palette
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
