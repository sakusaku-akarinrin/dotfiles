{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "none" },
    "display": {
        "separator": "  ",
        "key": {
            "type": "both",
            "paddingLeft": 2
        }
    },
    "modules": [
        { "type": "custom", "format": "{##8888cc}✉️  System{#}" },
        "separator",
        {
            "type": "os",
            "key": "  OS       ",
            "keyColor": "#8888cc"
        },
        {
            "type": "kernel",
            "key": "  Kernel   ",
            "keyColor": "#d4b06a"
        },
        {
            "type": "wm",
            "key": "  WM       ",
            "keyColor": "#5a6088"
        },
        {
            "type": "terminal",
            "key": "  Terminal ",
            "keyColor": "#d4b06a"
        },
        {
            "type": "shell",
            "key": "  Shell    ",
            "keyColor": "#5a6088"
        },
        {
            "type": "uptime",
            "key": "  Uptime   ",
            "keyColor": "#8888cc"
        },
        "break",
        { "type": "custom", "format": "{##5a9e7a}⚙  Hardware{#}" },
        "separator",
        {
            "type": "cpu",
            "key": "  CPU      ",
            "keyColor": "#d4b06a",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "  GPU      ",
            "keyColor": "#5a6088"
        },
        {
            "type": "memory",
            "key": "  Memory   ",
            "keyColor": "#d4b06a",
            "percent": { "type": 3 }
        },
        {
            "type": "disk",
            "key": "  Disk     ",
            "keyColor": "#5a9e7a",
            "folders": "/",
            "percent": { "type": 3 }
        },
        {
            "type": "battery",
            "key": "  Battery  ",
            "keyColor": "#d4b06a",
            "percent": { "type": 3 }
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
